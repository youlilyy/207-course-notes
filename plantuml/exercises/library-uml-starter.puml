@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

' Only some items can be borrowed, so borrowing lives in an interface that
' Book and DVD realize but ReferenceItem does not.
interface Borrowable {
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + addHold(hold : Hold) : void
}

class Book {
  - {static} LOAN_PERIOD_DAYS : int = 21
  - onLoan : boolean
  - holds : List<Hold>
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + addHold(hold : Hold) : void
}

class DVD {
  - {static} LOAN_PERIOD_DAYS : int = 7
  - onLoan : boolean
  - holds : List<Hold>
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + addHold(hold : Hold) : void
}

class ReferenceItem {
}

class Catalogue {
  - items : List<Item>
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

' Members and librarians are both people the library knows about.
abstract class Person {
  - name : String
  + getName() : String
}

class Member {
  - memberNumber : String
  - lateFee : double
  + logIn(memberNumber : String) : boolean
  + borrow(item : Borrowable) : void
  + placeHold(item : Borrowable) : Hold
  + setLateFee(amount : double) : void
}

class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

' A hold remembers who placed it and which item it is for.
class Hold {
  - member : Member
  - item : Borrowable
  - placedOn : LocalDate
}

Item <|-- Book
Item <|-- DVD
Item <|-- ReferenceItem
Borrowable <|.. Book
Borrowable <|.. DVD

Person <|-- Member
Person <|-- Librarian

Catalogue o-- "*" Item
Hold --> "1" Member
Hold --> "1" Borrowable
Borrowable "1" o-- "*" Hold : holds
Librarian ..> Catalogue
Librarian ..> Member
Member ..> Borrowable
@enduml